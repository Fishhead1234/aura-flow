datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String   @default("STUDENT") // "OWNER" | "STUDENT"
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedStudios Studio[]
  passes       ClientPass[]
  bookings     Booking[]
  waitlist     WaitlistEntry[]

  @@index([email])
}

model Studio {
  id                String   @id @default(uuid())
  ownerId           String?
  owner             User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  slug              String   @unique
  name              String
  currency          String   @default("USD")
  stripeAccountId   String   @default("acct_sol_sanctuary")
  cancelWindowHours Int      @default(12)
  waitlistMinutes   Int      @default(30)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  classes    ClassSession[]
  classPacks ClassPack[]
  passes     ClientPass[]

  @@index([slug])
}

model ClassSession {
  id           String   @id @default(uuid())
  studioId     String
  studio       Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  title        String
  category     String   @default("Reformer")
  instructor   String
  startTime    DateTime
  durationMins Int      @default(50)
  capacity     Int      @default(8)
  price        Float    @default(28.0)
  roomName     String   @default("Reformer Studio A")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings Booking[]
  waitlist WaitlistEntry[]

  @@index([studioId, startTime])
}

model ClassPack {
  id         String   @id @default(uuid())
  studioId   String
  studio     Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  name       String
  credits    Int      @default(5)
  price      Float    @default(115.0)
  expiryDays Int      @default(90)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  passes ClientPass[]

  @@index([studioId])
}

model ClientPass {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studioId         String
  studio           Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  packId           String
  pack             ClassPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  creditsRemaining Int      @default(2)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, studioId])
}

model Booking {
  id            String       @id @default(uuid())
  sessionId     String
  session       ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod String       @default("PASS_CREDIT") // "PASS_CREDIT" | "STRIPE_CARD" | "APPLE_PAY"
  status        String       @default("CONFIRMED") // "CONFIRMED" | "CANCELLED" | "CHECKED_IN"
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([sessionId])
  @@index([userId])
}

model WaitlistEntry {
  id             String       @id @default(uuid())
  sessionId      String
  session        ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  priorityOrder  Int          @default(1)
  status         String       @default("WAITING") // "WAITING" | "OFFERED" | "CLAIMED" | "EXPIRED" | "DECLINED"
  offerExpiresAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([sessionId])
  @@index([userId])
}
